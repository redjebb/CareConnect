rules_version = '2';

// CareConnect security model
// ---------------------------------------------------------------------------
// Every signed-in user must own a profile document users/{uid}. That document
// is the single source of truth for authorization (role + driverId) and it
// can only be created in two ways:
//   1. a MASTER_ADMIN writes it, or
//   2. the invited person claims it with the one-time token that was e-mailed
//      to them (invitations/{email}.token). The token is never readable by
//      anyone except staff, so knowing an e-mail address is not enough.
// All other collections derive their permissions from that role.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.email.lower();
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return signedIn() && exists(profilePath()) ? get(profilePath()).data.role : 'NONE';
    }

    // Bootstrap account: kept so the owner can never be locked out.
    function isBootstrapMaster() {
      return signedIn() && request.auth.token.email == 'redjebtudjar@gmail.com';
    }

    function isMaster() {
      return isBootstrapMaster() || role() == 'MASTER_ADMIN';
    }

    function isStaff() {
      return isMaster() || role() == 'MANAGER';
    }

    function isDriver() {
      return role() == 'DRIVER';
    }

    function myDriverId() {
      return isDriver() ? get(profilePath()).data.get('driverId', '') : '';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function invitePath() {
      return /databases/$(database)/documents/invitations/$(authEmail());
    }

    // The invited person proves ownership of the invitation with its token.
    function validClaim(d) {
      return exists(invitePath())
        && get(invitePath()).data.status == 'pending'
        && d.keys().hasOnly(['uid', 'email', 'role', 'driverId', 'inviteToken', 'createdAt'])
        && d.uid == request.auth.uid
        && d.email.lower() == authEmail()
        && d.role in ['DRIVER', 'MANAGER']
        && d.role == get(invitePath()).data.role
        && d.inviteToken == get(invitePath()).data.token
        && d.get('driverId', '') == get(invitePath()).data.get('driverId', '');
    }

    // Invitee may flip their own pending record to active, nothing else.
    function isSelfActivation() {
      return signedIn()
        && role() in ['DRIVER', 'MANAGER']
        && resource.data.email.lower() == authEmail()
        && changedKeys().hasOnly(['status', 'uid'])
        && request.resource.data.status == 'active'
        && request.resource.data.get('uid', '') == request.auth.uid;
    }

    // ------------------------------------------------------------------ users
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isStaff());
      allow list: if isStaff();
      allow create: if isMaster()
        || (signedIn() && request.auth.uid == uid && validClaim(request.resource.data));
      allow update, delete: if isMaster();
    }

    // ------------------------------------------------------------ invitations
    match /invitations/{inviteId} {
      // The token inside must never be readable by the invitee.
      allow get: if isStaff();
      allow list: if isStaff();
      allow create: if isStaff()
        && inviteId == request.resource.data.email.lower()
        && request.resource.data.role in ['DRIVER', 'MANAGER']
        && (request.resource.data.role == 'DRIVER' || isMaster());
      allow update: if isStaff()
        || (signedIn()
            && inviteId == authEmail()
            && resource.data.status == 'pending'
            && changedKeys().hasOnly(['status', 'activatedAt'])
            && request.resource.data.status == 'accepted');
      allow delete: if isStaff();
    }

    // ----------------------------------------------------------------- admins
    match /admins/{adminId} {
      allow read: if isStaff();
      allow create, delete: if isMaster();
      allow update: if isMaster() || isSelfActivation();
    }

    // ---------------------------------------------------------------- drivers
    match /drivers/{driverId} {
      allow get: if isStaff() || (isDriver() && driverId == myDriverId());
      allow list: if isStaff();
      allow create, delete: if isStaff();
      allow update: if isStaff() || isSelfActivation();
    }

    // ---------------------------------------------------------------- clients
    // One document per planned visit. Drivers only ever see their own visits.
    match /clients/{clientId} {
      allow read: if isStaff()
        || (isDriver() && resource.data.assignedDriverId == myDriverId());
      allow create, delete: if isStaff();
      allow update: if isStaff()
        || (isDriver()
            && resource.data.assignedDriverId == myDriverId()
            && changedKeys().hasOnly(['driverSignature', 'clientSignature', 'lastSignature', 'lastCheckIn', 'notes'])
            && request.resource.data.get('notes', '').size() <= 500);
    }

    // Registry holds personal data (EGN) -> staff only. Drivers may only
    // refresh the persistent access note of a person they just served.
    match /clients_registry/{entryId} {
      allow read, create, delete: if isStaff();
      allow update: if isStaff()
        || (isDriver()
            && changedKeys().hasOnly(['notes', 'notesUpdatedAt'])
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 500);
    }

    // --------------------------------------------------------------- schedule
    match /schedule/{docId} {
      allow read: if isStaff()
        || (isDriver() && resource.data.driverId == myDriverId());
      allow write: if isStaff();
    }

    // ----------------------------------------------------------------- shifts
    match /shifts/{shiftId} {
      allow read: if isStaff()
        || (isDriver() && resource.data.driverId == myDriverId());
      allow create: if isDriver()
        && request.resource.data.driverId == myDriverId()
        && request.resource.data.status == 'active';
      allow update: if isStaff()
        || (isDriver()
            && resource.data.driverId == myDriverId()
            && changedKeys().hasOnly(['endTime', 'status']));
      allow delete: if isStaff();
    }

    // -------------------------------------------------------- deliveryHistory
    match /deliveryHistory/{docId} {
      allow read: if isStaff()
        || (isDriver() && resource.data.driverId == myDriverId());
      allow create: if isDriver() && request.resource.data.driverId == myDriverId();
      allow update, delete: if isStaff();
    }

    // -------------------------------------------------------------- incidents
    match /incidents/{incidentId} {
      allow read: if isStaff()
        || (isDriver() && resource.data.driverId == myDriverId());
      allow create: if isStaff()
        || (isDriver() && request.resource.data.driverId == myDriverId());
      allow update, delete: if isStaff();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
